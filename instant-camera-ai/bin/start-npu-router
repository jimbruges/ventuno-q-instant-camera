#!/bin/bash
set -euo pipefail

project="${INSTANT_CAMERA_AI_HOME:-$HOME/instant-camera-ai}"
arguments=(
  --variant "standard=$project/models/qcs8275-ip-adapter-plus"
  --default-variant standard
  --host 0.0.0.0
  --port 7100
  --worker-port 7101
)

hyper="${INSTANT_CAMERA_HYPER_MODEL_DIR:-}"
if [[ -n "$hyper" && -d "$hyper" ]]; then
  arguments=(--variant "hyper=$hyper" "${arguments[@]}")
fi

exec /usr/bin/python3 "$project/src/npu_router.py" "${arguments[@]}"
